{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Published consultation catalog item.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 400 },
        "minTier": { "type": "string", "enum": ["free", "go", "pro"] },
        "isPublished": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "minTier", "isPublished", "sortOrder"]
    },
    "User": {
      "title": "User",
      "description": "User account consent and profile root.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "acceptedTermsAt": { "type": "string", "format": "date-time" },
        "confirmedAdultAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "acceptedTermsAt", "confirmedAdultAt", "createdAt"]
    },
    "BirthProfile": {
      "title": "BirthProfile",
      "description": "Natal chart birth data profile owned by a user.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "entityType": { "type": "string", "enum": ["person", "company", "country"] },
        "birthDateTime": { "type": "string", "maxLength": 32 },
        "locationName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gender": { "type": "string", "enum": ["male", "female", "unset"] },
        "consentedOther": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "birthDateTime", "locationName", "latitude", "longitude", "timezone", "gender"]
    },
    "Session": {
      "title": "Session",
      "description": "Consultation session with frozen preset config.",
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["personal", "synastry"] },
        "productSlug": { "type": "string", "maxLength": 64 },
        "profileId": { "type": "string", "maxLength": 128 },
        "profileIds": { "type": "array" },
        "profileName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 120 },
        "frozenPrompt": { "type": "string" },
        "frozenModel": { "type": "string" },
        "frozenTools": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mode", "profileId", "title", "frozenPrompt", "frozenModel"]
    },
    "Message": {
      "title": "Message",
      "description": "Consultation message document.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant", "tool"] },
        "parts": { "type": "array" },
        "suggestions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "parts", "createdAt"]
    },
    "Usage": {
      "title": "Usage",
      "description": "Monthly consultation quota counter.",
      "type": "object",
      "properties": {
        "periodStart": { "type": "string", "maxLength": 40 },
        "used": { "type": "number" }
      },
      "required": ["periodStart", "used"]
    }
  },
  "firestore": {
    "/products/{slug}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Published consultation products."
    },
    "/usage/{uid}": {
      "schema": { "$ref": "#/entities/Usage" },
      "description": "Monthly usage quota per user."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User consent and metadata."
    },
    "/users/{uid}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/BirthProfile" },
      "description": "User birth profiles."
    },
    "/users/{uid}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "User consultation sessions."
    },
    "/users/{uid}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Consultation messages."
    }
  }
}
