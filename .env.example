# 本地开发时复制为 apps/api/.env 与 apps/web/.env.local
# 生产环境敏感配置通过 Firebase Secret Manager (`firebase functions:secrets:set`) 注入

# Google Cloud / Firebase 项目配置（区域固定 asia-southeast1）
GCLOUD_PROJECT=replace_with_firebase_project_id
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Stripe（仅用于 deleteAccount 取消订阅及 Run Payments with Stripe 扩展配置）
STRIPE_SECRET_KEY=sk_test_replace_me

# 前端 Firebase Web SDK 公开配置（apps/web/.env.local）
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=replace_with_firebase_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_firebase_project_id
VITE_FIREBASE_APP_ID=replace_me
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=replace_me
