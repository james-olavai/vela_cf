# 本地开发时复制为 apps/api/.dev.vars；线上用 `wrangler secret put`

# 模型接入（LLD §4.6）。products.model_name 的前缀决定走哪一个；只用一种时另一组可留空。
# base URL 建议指向 Cloudflare AI Gateway 的对应路径，以便统一记录日志与成本。

# openai:<model> —— 任何 OpenAI 兼容接口（OpenAI / DeepSeek / Workers AI 兼容端点等）
OPENAI_COMPAT_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/<provider>
OPENAI_COMPAT_API_KEY=replace_me

# google:<model> —— Gemini API
GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=

# Better Auth
BETTER_AUTH_SECRET=replace_with_32_char_random_secret
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth（唯一登录方式）
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Stripe（Go / Pro 订阅）
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
