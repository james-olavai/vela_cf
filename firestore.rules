rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 商品目录：客户端只读已上架商品，禁止客户端写入
    match /products/{slug} {
      allow get: if isValidId(slug) && resource.data.isPublished == true;
      allow list: if resource.data.isPublished == true;
      allow write: if false;
    }

    // 城市缓存：仅服务端读写
    match /locations_cache/{queryKey} {
      allow read, write: if false;
    }

    // 所有业务写入统一由已鉴权 API 执行；Admin SDK/Stripe 扩展不受客户端 Rules 限制。
    match /usage/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list, write: if false;
    }

    // 用户主文档与子集合
    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow write: if false;

      // 出生档案：本人只读；增删改走 API 校验与套餐上限事务
      match /profiles/{profileId} {
        allow get: if isValidId(uid) && isValidId(profileId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
        allow write: if false;
      }

      // 会话：本人只读；生命周期由 API 控制，避免删除会话绕过在途锁
      match /sessions/{sessionId} {
        allow get: if isValidId(uid) && isValidId(sessionId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
        allow write: if false;

        // 消息：本人只读，仅服务端写入
        match /messages/{messageId} {
          allow get: if isValidId(uid) && isValidId(sessionId) && isValidId(messageId) && isOwner(uid);
          allow list: if isValidId(uid) && isValidId(sessionId) && isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Run Payments with Stripe 扩展集合
    match /customers/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;

      match /checkout_sessions/{id} {
        allow get: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow write: if false;
        allow list: if isValidId(uid) && isOwner(uid);
      }
      match /subscriptions/{id} {
        allow get: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
      }
      match /payments/{id} {
        allow get: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
      }
    }
  }
}
