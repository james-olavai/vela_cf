rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'birthDateTime', 'locationName', 'latitude', 'longitude', 'timezone', 'gender'])
        && data.keys().hasOnly(['name', 'entityType', 'birthDateTime', 'locationName', 'latitude', 'longitude', 'timezone', 'gender', 'consentedOther', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && (!('entityType' in data) || data.entityType in ['person', 'company', 'country'])
        && data.birthDateTime is string && data.birthDateTime.size() > 0 && data.birthDateTime.size() <= 32
        && data.locationName is string && data.locationName.size() > 0 && data.locationName.size() <= 200
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 80
        && data.gender in ['male', 'female', 'unset']
        && (!('consentedOther' in data) || data.consentedOther is bool);
    }

    // 商品目录：客户端只读已上架商品，禁止客户端写入
    match /products/{slug} {
      allow get: if isValidId(slug) && resource.data.isPublished == true;
      allow list: if resource.data.isPublished == true;
      allow write: if false;
    }

    // 城市缓存：仅服务端读写
    match /locations_cache/{queryKey} {
      allow read, write: if false;
    }

    // 配额：客户端本人只读；仅允许本人按日领取分享奖励（上限 3 次/月，每次 +30000 micro-USD）
    match /usage/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list, delete: if false;
      allow create: if isValidId(uid) && isOwner(uid)
        && request.resource.data.keys().hasOnly(['periodStart', 'used', 'bonusMicroUsd', 'shareCount', 'lastShareDate'])
        && request.resource.data.periodStart is string && request.resource.data.periodStart.size() == 7
        && request.resource.data.used == 0
        && request.resource.data.bonusMicroUsd == 30000
        && request.resource.data.shareCount == 1
        && request.resource.data.lastShareDate is string && request.resource.data.lastShareDate.size() == 10;
      allow update: if isValidId(uid) && isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bonusMicroUsd', 'shareCount', 'lastShareDate'])
        && request.resource.data.bonusMicroUsd == resource.data.get('bonusMicroUsd', 0) + 30000
        && request.resource.data.bonusMicroUsd <= 90000
        && request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1
        && request.resource.data.shareCount <= 3
        && request.resource.data.lastShareDate is string
        && request.resource.data.lastShareDate.size() == 10
        && request.resource.data.lastShareDate != resource.data.get('lastShareDate', '');
    }

    // 用户主文档与子集合
    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create, update: if isValidId(uid) && isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'acceptedTermsAt', 'confirmedAdultAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'acceptedTermsAt', 'confirmedAdultAt', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254;
      allow delete: if isValidId(uid) && isOwner(uid);

      // 出生档案：本人可增删改查
      match /profiles/{profileId} {
        allow get, delete: if isValidId(uid) && isValidId(profileId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
        allow create, update: if isValidId(uid) && isValidId(profileId) && isOwner(uid)
          && isValidProfile(request.resource.data);
      }

      // 会话：本人可读、可删；创建与更新由服务端控制以冻结配置
      match /sessions/{sessionId} {
        allow get, delete: if isValidId(uid) && isValidId(sessionId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
        allow create, update: if false;

        // 消息：本人只读，仅服务端写入
        match /messages/{messageId} {
          allow get: if isValidId(uid) && isValidId(sessionId) && isValidId(messageId) && isOwner(uid);
          allow list: if isValidId(uid) && isValidId(sessionId) && isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Run Payments with Stripe 扩展集合
    match /customers/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;

      match /checkout_sessions/{id} {
        allow get, create: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
      }
      match /subscriptions/{id} {
        allow get: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
      }
      match /payments/{id} {
        allow get: if isValidId(uid) && isValidId(id) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid);
      }
    }
  }
}
