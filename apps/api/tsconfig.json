{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@vela-cf/shared": ["../../packages/shared/src/index.ts"],
      "@vela-cf/astrology": ["../../packages/astrology/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
