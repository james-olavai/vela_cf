{
  "name": "vela-cf",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace=apps/web run build",
    "check": "node scripts/check-boundaries.mjs",
    "dev": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "lint": "npm run check && npm run typecheck",
    "preview": "npm --workspace=apps/web run preview",
    "test": "node --import ./scripts/register-ts.mjs --test packages/astrology/src/astrology.test.ts apps/api/src/api.test.ts apps/api/playground-fixtures/fixtures.test.mjs apps/api/src/prompt-bundle.test.ts apps/api/src/gateway-model.test.ts apps/api/src/skills-routing.test.ts scripts/ci/release.test.mjs scripts/ci/release-phases.test.mjs scripts/ci/environments.test.mjs scripts/ci/live-smoke.test.mjs apps/api/src/http-api.test.ts apps/api/src/chat-service.test.ts apps/api/src/session-commit.test.ts apps/api/src/pat.test.ts scripts/chat-errors.test.mjs apps/api/src/business-api.test.ts apps/api/src/tuning-api.test.ts scripts/api-contract.test.mjs scripts/api-client.test.mjs apps/api/src/subjects.test.ts apps/api/src/locations.test.ts apps/api/src/country-charts.test.ts apps/api/src/action-api.test.ts apps/api/src/stripe-payments.test.ts apps/api/src/portrait.test.ts scripts/subscription-client.test.mjs scripts/turn-client.test.mjs scripts/plan-store.test.mjs scripts/geo-client.test.mjs scripts/catalog-check.test.mjs scripts/ci/stripe-live.test.mjs scripts/ci/stripe-production.test.mjs",
    "test:frontend": "node scripts/frontend-regressions.mjs",
    "test:e2e": "node scripts/ci-smoke.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "deploy:api": "npm --workspace=apps/api run deploy",
    "prompt:build": "node scripts/prompt-build.mjs",
    "prompt:check": "node scripts/prompt-build.mjs --check",
    "prompt:mcp": "node scripts/prompt-mcp.mjs",
    "test:prompt-mcp": "node --test scripts/prompt-mcp-jobs.test.mjs",
    "test:prompts": "node --test scripts/prompt-build.test.mjs scripts/prompt-mcp-jobs.test.mjs",
    "tuning:pack": "node scripts/tuning-pack.mjs",
    "test:tuning": "node --test scripts/tuning-smoke.test.mjs",
    "prompt:ab": "node scripts/prompt-ab.mjs",
    "test:rules": "node --import ./scripts/register-ts.mjs --test apps/api/src/firestore-emulator.test.ts",
    "test:ci-ui": "node scripts/ci-smoke.mjs",
    "test:pat-ui": "node scripts/pat-ui-browser.mjs",
    "release:prepare": "node scripts/ci/prepare-release.mjs",
    "environment:check": "node scripts/ci/environments.mjs",
    "release:bind": "node scripts/ci/bind-artifact.mjs",
    "release": "node scripts/ci/release.mjs",
    "api:generate": "node --import ./scripts/register-ts.mjs scripts/api-contract.mjs docs/openapi.json",
    "catalog:check": "node --import ./scripts/register-ts.mjs scripts/catalog-check.mjs",
    "api:check": "node --import ./scripts/register-ts.mjs scripts/api-contract.mjs docs/openapi.json --check",
    "test:api-emulator": "VELA_BUSINESS_EMULATOR_TEST=1 node --import ./scripts/register-ts.mjs --test scripts/ci/api-emulator.test.mjs apps/api/src/business-api.test.ts",
    "test:pat-emulator": "VELA_PAT_EMULATOR_TEST=1 node --import ./scripts/register-ts.mjs --test apps/api/src/pat.test.ts scripts/ci/pat-emulator.test.mjs",
    "test:api-functions": "node --import ./scripts/register-ts.mjs --test scripts/ci/api-functions.test.mjs scripts/ci/api-chat-emulator.test.mjs",
    "test:api-browser": "node scripts/ci/api-browser.mjs",
    "test:stripe-emulator": "node --import ./scripts/register-ts.mjs --test scripts/ci/stripe-emulator.test.mjs",
    "test:stripe-live": "node scripts/ci/stripe-live.mjs",
    "test:stripe": "node scripts/ci/stripe-test.mjs",
    "test:company-synastry-live": "VELA_LIVE_MODE=company-synastry-staging node scripts/ci/live-smoke.mjs",
    "test:stripe-lifecycle": "node scripts/ci/stripe-test.mjs --lifecycle-only",
    "test:company-synastry-browser": "node scripts/ci/company-synastry-browser.mjs",
    "billing:production-check": "node scripts/ci/stripe-production.mjs"
  }
}
