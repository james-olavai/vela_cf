{
  "_readme": "项目边界与排期的唯一机器可读来源。由 scripts/check-boundaries.mjs 强制执行（npm run check，以及 Claude Code 的 PostToolUse 钩子）。修改本文件 = 修改项目范围，必须由项目负责人批准，并同步 docs/LLD.md §6。",

  "workspaces": {
    ".": {
      "maxSourceLines": 0,
      "dependencies": []
    },
    "apps/api": {
      "maxSourceLines": 3600,
      "maxCallableFunctions": 7,
      "dependencies": [
        "@modelcontextprotocol/sdk",
        "@genkit-ai/firebase",
        "@genkit-ai/google-genai",
        "@genkit-ai/vertexai",
        "@types/node",
        "@vela-cf/astrology",
        "@vela-cf/shared",
        "firebase-admin",
        "firebase-functions",
        "genkit",
        "stripe",
        "typescript",
        "zod"
      ]
    },
    "apps/web": {
      "maxSourceLines": 6000,
      "dependencies": [
        "@assistant-ui/react",
        "@assistant-ui/react-markdown",
        "@invertase/firestore-stripe-payments",
        "@tailwindcss/vite",
        "@types/qrcode",
        "@types/react",
        "@types/react-dom",
        "@vela-cf/shared",
        "@vitejs/plugin-react",
        "firebase",
        "qrcode",
        "react",
        "react-dom",
        "react-markdown",
        "remark-gfm",
        "tailwindcss",
        "typescript",
        "vite",
        "zod"
      ]
    },
    "packages/astrology": {
      "maxSourceLines": 4500,
      "dependencies": [
        "iztro",
        "lunar-javascript",
        "typescript",
        "zod"
      ]
    },
    "packages/shared": {
      "maxSourceLines": 380,
      "dependencies": [
        "typescript",
        "zod"
      ]
    }
  },

  "firebase": {
    "region": "asia-southeast1",
    "allowedTopKeys": [
      "firestore",
      "functions",
      "hosting",
      "emulators",
      "extensions",
      "remoteconfig"
    ],
    "security": {
      "maxChatInputChars": 2000,
      "maxToolTurns": 3,
      "maxAstrologyTools": 35,
      "forbidSideEffectsInTools": true,
      "forbidOpenFirestoreWrites": true
    }
  },

  "deferred": [
    "自建定制化运营后台 UI（直接用 Firebase Console + Remote Config + Stripe Dashboard）",
    "Google Cloud Model Armor（出现高频越狱/套词攻击时在 chat 入口开启）",
    "其余排盘技法（合盘、次限、返照、法达、恒星等）",
    "对外 Remote MCP 服务",
    "Cloud SQL / Data Connect、Cloud Storage、Pub/Sub、Cloud Tasks、定时任务",
    "Langfuse、PostHog 等非 Google 原生分析/埋点 SDK",
    "第三方社交与开发者平台 SSO（GitHub / Discord / Microsoft / X (Twitter)）",
    "前端路由库、状态管理库、组件库",
    "第三方测试框架（统一用 node:test 与 Firebase Emulator）",
    "i18n"
  ],

  "schedule": {
    "_assumption": "一人全职，2026-11-16 开工。开工日或人力变化时由负责人改这里。",
    "phases": [
      { "id": "phase-0", "name": "Phase 0 风险验证", "deadline": "2026-11-18", "done": false },
      { "id": "slice-1", "name": "切片 1 最细链路", "deadline": "2026-11-30", "done": false },
      { "id": "slice-2", "name": "切片 2 排盘补全", "deadline": "2026-12-07", "done": false },
      { "id": "slice-3", "name": "切片 3 配额与订阅", "deadline": "2026-12-14", "done": false },
      { "id": "slice-4", "name": "切片 4 前端补全", "deadline": "2026-12-21", "done": false },
      { "id": "launch", "name": "上线准备", "deadline": "2026-12-24", "done": false }
    ]
  }
}
